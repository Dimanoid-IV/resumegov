# This file documents the isolated paid-flow environment.
# Never copy production values into this environment.

VERCEL_ENV=preview
BILLING_TEST_MODE=true

# Dedicated Supabase test project. These two values must match exactly.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_TEST_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_TEST_SERVICE_ROLE_KEY

# Temporary Stripe sandbox. The secret key must begin with sk_test_ or rkcs_test_.
STRIPE_SECRET_KEY=YOUR_STRIPE_TEST_SECRET
STRIPE_WEBHOOK_SECRET=YOUR_TEST_WEBHOOK_SECRET
STRIPE_PRICE_ANALYST=price_1TyHg8PgXdRkerFzMoyamwWB
STRIPE_PRICE_PROFESSIONAL=price_1TyHgAPgXdRkerFzmG2VK8mS

NEXT_PUBLIC_SITE_URL=https://YOUR_TEST_DEPLOYMENT.vercel.app
OPENAI_API_KEY=YOUR_NON_PRODUCTION_OPENAI_KEY
NEXT_PUBLIC_ENABLE_GA4=false
